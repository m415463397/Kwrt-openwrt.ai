#!/bin/sh

uci set system.@system[0].hostname='openwrt'
uci set system.@system[0].links='0'
uci set network.lan.ipaddr='192.168.10.1'

# Disable IPv6 on LAN only.
uci set network.lan.ipv6='0'
uci set network.lan.ip6assign='0'
uci set dhcp.lan.ra='disabled'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ndp='disabled'

# Keep the LAN/WAN interfaces generated by the x86 board network setup.
# Do not delete br-lan or force LAN to eth0.

uci commit system
uci commit network
uci commit dhcp

printf '%s\n' 'openwrt' 'openwrt' | passwd root >/dev/null 2>&1
exit 0
