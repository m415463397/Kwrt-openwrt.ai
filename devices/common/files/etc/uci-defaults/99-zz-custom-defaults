#!/bin/sh

uci set system.@system[0].hostname='openwrt'
uci set system.@system[0].links='0'
uci set network.lan.ipaddr='192.168.10.1'

# Disable IPv6 on LAN only.
uci set network.lan.ipv6='0'
uci set network.lan.ip6assign='0'
uci set dhcp.lan.ra='disabled'
uci set dhcp.lan.dhcpv6='disabled'
uci set dhcp.lan.ndp='disabled'

# Remove the generated br-lan bridge and use eth0 directly.
for section in $(uci -q show network | sed -n 's/^network\.\(@device\[[0-9][0-9]*\]\)=device$/\1/p'); do
    name="$(uci -q get "network.${section}.name")"
    if [ "$name" = "br-lan" ]; then
        uci -q delete "network.${section}"
    fi
done
uci set network.lan.device='eth0'
uci -q delete network.lan.type

uci commit system
uci commit network
uci commit dhcp
exit 0
